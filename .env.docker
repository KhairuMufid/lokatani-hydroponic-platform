# ═══════════════════════════════════════════════════════════
# Lokatani Platform — Docker Environment Variables
#
# Copy this file to .env in the project root before running:
#   cp .env.docker .env
#   docker compose up -d --build
#
# IMPORTANT: Change ALL default secrets before production!
# ═══════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=lokatani

# ─── Security (MUST change in production) ─────────────
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN_SEC=86400
API_KEY=CHANGE_ME_DEVICE_API_KEY
